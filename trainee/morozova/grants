CREATE USER blog_app IDENTIFIED BY app;
CREATE USER blog_admin IDENTIFIED BY admin;

GRANT CREATE SESSION TO blog_app;
GRANT CREATE SESSION TO blog_admin;

GRANT INSERT, UPDATE, SELECT, DELETE ON DELL.ARTICLE TO blog_app;
GRANT SELECT ON DELL.ARTICLE_COMMENT_V TO blog_app;
GRANT EXECUTE ON DELL.TAPI_COMMENT TO blog_app;

GRANT EXECUTE ON DELL.TAPI_AUDIT TO blog_admin;
