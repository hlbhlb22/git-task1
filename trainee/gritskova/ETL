--Create table for dim_article
CREATE TABLE dim_article(sid int GENERATED BY DEFAULT ON
NULL AS IDENTITY,
nid int NOT NULL,
crt_dt DATE NOT NULL,
mod_dt DATE NOT NULL,
author varchar2(128) NOT NULL,
title varchar2(50) NOT NULL,
content clob NOT NULL,
start_dt DATE DEFAULT CURRENT_TIMESTAMP NOT NULL,
end_dt DATE DEFAULT NULL,
is_act_ind NUMBER(1),
CONSTRAINT dim_article_pk PRIMARY KEY (sid),
CONSTRAINT dim_article_c CHECK (is_act_ind = 1
	OR is_act_ind IS NULL)
);

--Create table for dim_dates
CREATE TABLE dim_dates AS 
WITH base_calendar AS
 (
SELECT
	TO_NUMBER(TO_CHAR(currdate, 'YYYYMMDD')) AS id,
	currdate AS d_date,
	TO_CHAR(currdate, 'YYYY') AS d_year,
	CASE
		WHEN to_number(TO_CHAR(currdate, 'Q') ) <= 2 THEN 1
		ELSE 2
	END AS half_year,
	to_number(TO_CHAR(currdate, 'Q') ) AS d_quarter,
	to_number(TO_CHAR(currdate, 'MM')) AS d_month,
	TO_CHAR(currdate, 'MONTH') AS name_month,
	to_number(TRIM(LEADING '0' FROM TO_CHAR(currdate, 'DDD'))) AS d_day,
	to_number(TO_CHAR(currdate, 'WW')) AS d_week
FROM
	(
	SELECT
		LEVEL n,
		TO_DATE('31/12/2020', 'DD/MM/YYYY') + numtodsinterval(LEVEL, 'DAY') currdate
	FROM
		dual
	CONNECT BY
		LEVEL <= 1461
        )
)
SELECT
	id AS id,
	d_date AS d_date,
	d_year AS d_year,
	half_year AS half_year,
	d_quarter AS d_quarter,
	d_month AS d_month,
	name_month AS name_month,
	d_day AS d_day,
	d_week AS d_week,
	MIN(id) OVER(PARTITION BY d_month, d_year) AS begin_of_month,
	MAX(id) OVER(PARTITION BY d_month, d_year) AS end_of_month
FROM
	base_calendar;
	
--Add primary key for dim_article
ALTER TABLE dim_dates
ADD CONSTRAINT dim_dates_pk PRIMARY KEY (id);

--Create table for f_article_comment
CREATE TABLE f_article_comment(sid int GENERATED BY DEFAULT ON
	NULL AS IDENTITY,
	article_sid int NOT NULL,
	date_id int NOT NULL,
	comment_id int NOT NULL,
	time_ival INTERVAL DAY TO SECOND NOT NULL,
	rating int NOT NULL,
	votes int NOT NULL,
	content clob NOT NULL,
action_type char(1),
	CONSTRAINT f_article_comment_pk PRIMARY KEY (sid),
	CONSTRAINT f_article_comment_fk_dim_dates FOREIGN KEY (date_id) REFERENCES dim_dates (id));
	
--Create or replace package declaration for ETL
CREATE OR REPLACE
PACKAGE
	DWH.etl_blog IS

PROCEDURE etl_load_comments;
END etl_blog;

--Create or replace package body for ETL
CREATE OR REPLACE
PACKAGE
	BODY etl_blog IS
	--Procedure ETL for loading articles 
PROCEDURE etl_load_articles AS
v_a_mod_dt int;

v_nid int;

CURSOR article_c IS
SELECT
	id,
	crt_dt,
	mod_dt,
	author,
	title,
	content
FROM
	BLOG_BASE.article;

BEGIN
	
FOR rec IN article_c LOOP

SELECT
	count(*)
INTO
	v_nid
FROM
	DIM_ARTICLE da
WHERE
	da.NID = rec.id;

SELECT
	COUNT(*) 
INTO
	v_a_mod_dt
FROM
		DIM_ARTICLE da
WHERE
		da.nid = rec.id
	AND (da.CRT_DT <> rec.crt_dt
		OR da.MOD_DT <> rec.mod_dt
		OR rec.author <> da.AUTHOR
		OR da.TITLE <> rec.title)
	AND da.IS_ACT_IND = 1;

IF v_nid = 0 THEN
INSERT
	INTO
	DIM_ARTICLE (nid,
	crt_dt,
	mod_dt,
	author,
	title,
	content,
	is_act_ind)
VALUES (rec.id,
rec.crt_dt,
rec.mod_dt,
rec.author,
rec.title,
rec.content,
1);

ELSIF
	v_a_mod_dt <> 0 THEN
UPDATE
	DIM_ARTICLE
SET
	IS_ACT_IND = NULL,
	END_DT = current_timestamp
WHERE
	sid = (
	SELECT
		max(sid)
	FROM
		DIM_ARTICLE da2
	WHERE
		nid = rec.id);

INSERT
	INTO
	DIM_ARTICLE (nid,
	crt_dt,
	mod_dt,
	author,
	title,
	content,
	is_act_ind)
VALUES (rec.id,
rec.crt_dt,
rec.mod_dt,
rec.author,
rec.title,
rec.content,
1);
END
IF;
END
LOOP;
END etl_load_articles;

--Pricedure for loading comments 
PROCEDURE etl_load_comments IS CURSOR article_comment_c IS
SELECT
	id,
	article_id,
	ts,
	REPLY_TO_ID,
	rating,
	votes,
	COMMENTER,
	content
FROM
	BLOG_BASE.article_comment;

v_time_ival blog_base.audit_action.ts%TYPE;

v_action_type blog_base.audit_action.action_type%TYPE;

v_sid dim_article.sid%TYPE;

v_date_id dim_dates.id%TYPE;

v_int dim_article.sid%TYPE;

BEGIN
--Execute of loading articles 
etl_load_articles();

FOR rec IN article_comment_c LOOP

--Select data from audit_action
SELECT
	ts,
	ACTION_TYPE
INTO
	v_time_ival,
	v_action_type
FROM
	(
	SELECT
		ts,
		action_type
	FROM
		blog_base.audit_action bbaa
	WHERE
		bbaa.TABLE_NAME = 'article_comment'
		AND bbaa.row_id = rec.id
	ORDER BY
		ts DESC)
WHERE
	rownum = 1;
--Select data from dim_article
SELECT 
	sid
INTO
	v_sid
FROM
	DIM_ARTICLE da
WHERE
	da.NID = rec.article_id
	AND da.IS_ACT_IND = 1;
	
--Select data from dim_dates
SELECT
	id
INTO
	v_date_id
FROM
	DIM_DATES dd
WHERE
	to_char(d_date, 'dd.MM.yyy') = to_char(v_time_ival, 'dd.MM.yyy');

v_int := v_sid;

--SQL MERGE with collected data
MERGE
INTO
	F_ARTICLE_COMMENT fac
		USING dual ON
	(fac.COMMENT_ID = rec.id)
	WHEN MATCHED THEN
UPDATE
SET
	fac.ARTICLE_SID = v_sid,
	fac.date_id = v_date_id,
	fac.time_ival = TO_DSINTERVAL('0' || ' ' || TO_CHAR(v_time_ival, 'hh24:mi:ss')),
	fac.RATING = rec.rating,
	fac.votes = rec.votes,
	fac.CONTENT = rec.content,
	fac.ACTION_TYPE = v_action_type
WHERE
	fac.COMMENT_ID = rec.id
	WHEN NOT MATCHED THEN
INSERT
	(ARTICLE_SID,
	DATE_ID,
	COMMENT_ID,
	TIME_IVAL,
	RATING,
	VOTES,
	CONTENT,
	ACTION_TYPE)
VALUES (v_sid,
v_date_id,
rec.id,
TO_DSINTERVAL('0' || ' ' || TO_CHAR(v_time_ival, 'HH24:Mi:SS')),
rec.rating,
rec.votes,
rec.content,
v_action_type)
WHERE
v_sid = v_int;
END
LOOP;
END etl_load_comments;
END etl_blog;

