--Create table for audit
CREATE TABLE audit_action(id NUMBER(38,
0) GENERATED BY DEFAULT ON
NULL AS IDENTITY,
ts timestamp(0) NOT NULL,
table_name varchar2(128) NOT NULL,
user_name varchar2(128) NOT NULL,
action_type char(1) NOT NULL,
action_summary varchar2(250),
CONSTRAINT audit_action_pk PRIMARY KEY (id)
);

--Create or replace autonomus transaction procedure
CREATE OR REPLACE
PROCEDURE audit_sproc(i_ts timestamp,
i_table_name varchar2,
i_user_name varchar2,
i_action_type char,
i_action_summary varchar2) IS PRAGMA AUTONOMOUS_TRANSACTION;

BEGIN
	INSERT
	INTO
	AUDIT_ACTION (ts,
	TABLE_NAME,
	USER_NAME,
	ACTION_TYPE,
	ACTION_SUMMARY)
VALUES (i_ts,
i_table_name,
i_user_name,
i_action_type,
i_action_summary);

COMMIT;
END audit_sproc;

--Create or replace trigger for audit article
CREATE OR REPLACE
TRIGGER article_trg_biudr BEFORE 
INSERT
	OR
UPDATE
	OR
DELETE
	ON
	article FOR EACH ROW
DECLARE
		v_name varchar2(8);

v_action_type char(1);
BEGIN

--Get username
	SELECT
	sys_context('USERENV', 'SESSION_USER')
INTO
	v_name
FROM
	dual;
	
--Get action
IF inserting THEN v_action_type := 'I';
ELSE IF updating THEN v_action_type := 'U';
ELSE v_action_type := 'D';
END IF;
END IF;

audit_sproc(CURRENT_TIMESTAMP,
	'article',
	v_name,
	v_action_type,
	concat(:NEW.author, concat(' ', concat(:NEW.title, concat(' ', :NEW.content)))));
END article_trg_biudr;

