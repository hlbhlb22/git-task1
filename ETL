PACKAGE
	BODY etl_blog IS
--Procedure ETL for loading articles 
PROCEDURE etl_load_articles AS v_id blog_base.article.id%TYPE;

v_crt_dt blog_base.ARTICLE.CRT_DT%TYPE;

v_mod_dt blog_base.article.mod_dt%TYPE;

v_author blog_base.article.author%TYPE;

v_title blog_base.article.title%TYPE;

v_content blog_base.article.content%TYPE;

v_a_mod_dt int;

v_nid int;

CURSOR article_c IS
SELECT
	id,
	crt_dt,
	mod_dt,
	author,
	title,
	content
FROM
	BLOG_BASE.article;

BEGIN
	
OPEN article_c;	-- use: FOR...LOOP for cursors

LOOP FETCH article_c
INTO
	v_id,
	v_crt_dt,
	v_mod_dt,
	v_author,
	v_title,
	v_content;

EXIT
WHEN article_c%notfound;

SELECT
	count(*)
INTO
	v_nid
FROM
	DIM_ARTICLE da
WHERE
	da.NID = v_id;

SELECT
	COUNT(*) 
INTO
	v_a_mod_dt
FROM
		DIM_ARTICLE da
WHERE
		da.nid = v_id
	AND (da.CRT_DT <> v_crt_dt
		OR da.MOD_DT <> v_mod_dt
		OR v_author <> da.AUTHOR
		OR da.TITLE <> v_title)
	AND da.IS_ACT_IND = 1;

IF v_nid = 0 THEN
INSERT
	INTO
	DIM_ARTICLE (nid,
	crt_dt,
	mod_dt,
	author,
	title,
	content,
	is_act_ind)
VALUES (v_id,
v_crt_dt,
v_mod_dt,
v_author,
v_title,
v_content,
1);

ELSIF
	v_a_mod_dt <> 0 THEN
UPDATE
	DIM_ARTICLE
SET
	IS_ACT_IND = NULL,
	END_DT = current_timestamp
WHERE
	sid = (
	SELECT
		max(sid)
	FROM
		DIM_ARTICLE da2
	WHERE
		nid = v_id);

INSERT
	INTO
	DIM_ARTICLE (nid,
	crt_dt,
	mod_dt,
	author,
	title,
	content,
	is_act_ind)
VALUES (v_id,
v_crt_dt,
v_mod_dt,
v_author,
v_title,
v_content,
1);
END
IF;
END
LOOP;

CLOSE article_c;
END etl_load_articles;
--Pricedure for loading comments 
PROCEDURE etl_load_comments IS CURSOR article_comment_c IS
SELECT
	id,
	article_id,
	ts,
	REPLY_TO_ID,
	rating,
	votes,
	COMMENTER,
	content
FROM
	BLOG_BASE.article_comment;

v_id int;

v_article_id blog_base.article_comment.article_id%TYPE;

v_ts blog_base.article_comment.ts%TYPE;

v_REPLY_TO_ID blog_base.article_comment.REPLY_TO_ID%TYPE;

v_rating blog_base.article_comment.rating%TYPE;

v_votes blog_base.article_comment.votes%TYPE;

v_COMMENTER blog_base.article_comment.commenter%TYPE;

v_content blog_base.article_comment.content%TYPE;

v_time_ival blog_base.audit_action.ts%TYPE;

v_action_type blog_base.audit_action.action_type%TYPE;

v_sid dim_article.sid%TYPE;

v_date_id dim_dates.id%TYPE;

v_int dim_article.sid%TYPE;

BEGIN
--Execute of loading articles 
etl_load_articles();

OPEN article_comment_c;

LOOP FETCH article_comment_c
INTO
	v_id,
	v_article_id,
	v_ts,
	v_REPLY_TO_ID,
	v_rating,
	v_votes,
	v_COMMENTER,
	v_content;

EXIT
WHEN article_comment_c%notfound;
--Select data from audit_action
SELECT
	ts,
	ACTION_TYPE
INTO
	v_time_ival,
	v_action_type
FROM
	(
	SELECT
		ts,
		action_type
	FROM
		blog_base.audit_action bbaa
	WHERE
		bbaa.TABLE_NAME = 'article_comment'
		AND bbaa.row_id = v_id
	ORDER BY
		ts DESC)
WHERE
	rownum = 1;
--Select data from dim_article
SELECT 
	sid
INTO
	v_sid
FROM
	DIM_ARTICLE da
WHERE
	da.NID = v_article_id
	AND da.IS_ACT_IND = 1;
--Select data from dim_dates
SELECT
	id
INTO
	v_date_id
FROM
	DIM_DATES dd
WHERE
	to_char(d_date, 'dd.MM.yyy') = to_char(v_time_ival, 'dd.MM.yyy');

v_int := v_sid;
--SQL MERGE with collected data
MERGE
INTO
	F_ARTICLE_COMMENT fac
		USING dual ON
	(fac.COMMENT_ID = v_id)
	WHEN MATCHED THEN
UPDATE
SET
	fac.ARTICLE_SID = v_sid,
	fac.date_id = v_date_id,
	fac.time_ival = TO_DSINTERVAL('0' || ' ' || TO_CHAR(v_time_ival, 'hh24:mi:ss')),
	fac.RATING = v_rating,
	fac.votes = v_votes,
	fac.CONTENT = v_content,
	fac.ACTION_TYPE = v_action_type
WHERE
	fac.COMMENT_ID = v_id
	WHEN NOT MATCHED THEN
INSERT
	(ARTICLE_SID,
	DATE_ID,
	COMMENT_ID,
	TIME_IVAL,
	RATING,
	VOTES,
	CONTENT,
	ACTION_TYPE)
VALUES (v_sid,
v_date_id,
v_id,
TO_DSINTERVAL('0' || ' ' || TO_CHAR(v_time_ival, 'HH24:Mi:SS')),
v_rating,
v_votes,
v_content,
v_action_type)
WHERE
v_sid = v_int;
END
LOOP;

CLOSE article_comment_c;
END etl_load_comments;
END etl_blog;
