--Create table for dim_article
CREATE TABLE dim_article(sid int GENERATED BY DEFAULT ON
NULL AS IDENTITY,
nid int NOT NULL,
crt_dt DATE NOT NULL,
mod_dt DATE NOT NULL,
author varchar2(128) NOT NULL,
title varchar2(50) NOT NULL,
content clob NOT NULL,
start_dt DATE DEFAULT CURRENT_TIMESTAMP NOT NULL,
end_dt DATE DEFAULT NULL,
is_act_ind NUMBER(1),
CONSTRAINT dim_article_pk PRIMARY KEY (sid),
CONSTRAINT dim_article_c CHECK (is_act_ind = 1
	OR is_act_ind IS NULL)
);
--Create table for dim_dates
CREATE TABLE dim_dates AS 
WITH base_calendar AS
 (
SELECT
	-- TODO: to_number( to_char( currdate, 'YYYYMMDD'))
	TO_NUMBER(TO_CHAR(currdate, 'YYYY') || TO_char(currdate, 'MM') || TO_CHAR(currdate, 'DD')) AS id,
	currdate AS d_date,
	TO_CHAR(currdate, 'YYYY') AS d_year,  -- TODO: extract( year from <date>) - preserve NUMBER data type
	CASE
		WHEN to_number(TO_CHAR(currdate, 'Q') ) <= 2 THEN 1
		ELSE 2
	END AS half_year,
	to_number(TO_CHAR(currdate, 'Q') ) AS d_quarter,
	to_number(TRIM(LEADING '0' FROM TO_CHAR(currdate, 'MM'))) AS d_month, -- TODO: it can work without trimming
	TO_CHAR(currdate, 'MONTH') AS name_month,
	to_number(TRIM(LEADING '0' FROM TO_CHAR(currdate, 'DDD'))) AS d_day,
	to_number(TO_CHAR(currdate, 'WW')) AS d_week
FROM
	(
	SELECT
		LEVEL n,
		TO_DATE('31/12/2020', 'DD/MM/YYYY') + numtodsinterval(LEVEL, 'DAY') currdate
	FROM
		dual
	CONNECT BY
		LEVEL <= 1461
        )
)
SELECT
	id AS id,
	d_date AS d_date,
	d_year AS d_year,
	half_year AS half_year,
	d_quarter AS d_quarter,
	d_month AS d_month,
	name_month AS name_month,
	d_day AS d_day,
	d_week AS d_week,
	MIN(id) OVER(PARTITION BY d_month, d_year) AS begin_of_month,
	MAX(id) OVER(PARTITION BY d_month, d_year) AS end_of_month
FROM
	base_calendar;
--Add primary key for dim_article
ALTER TABLE dim_dates
ADD CONSTRAINT dim_dates_pk PRIMARY KEY (id);
--Create table for f_article_comment
CREATE TABLE f_article_comment(sid int GENERATED BY DEFAULT ON
	NULL AS IDENTITY,
	article_sid int NOT NULL,
	date_id int NOT NULL,
	comment_id int NOT NULL,
	time_ival INTERVAL DAY TO SECOND NOT NULL,
	rating int NOT NULL,
	votes int NOT NULL,
	content clob NOT NULL,
action_type char(1),
	CONSTRAINT f_article_comment_pk PRIMARY KEY (sid),
	CONSTRAINT f_article_comment_fk_dim_dates FOREIGN KEY (date_id) REFERENCES dim_dates (id));
