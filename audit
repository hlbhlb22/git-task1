CREATE TABLE audit_action(id NUMBER(38,
0) GENERATED BY DEFAULT ON
NULL AS IDENTITY,
ts timestamp(0) NOT NULL,
table_name varchar2(128) NOT NULL,
user_name varchar2(128) NOT NULL,
action_type char(1) NOT NULL,
action_summary varchar2(250),
CONSTRAINT audit_action_pk PRIMARY KEY (id)
);

CREATE CONTEXT skey
	USING tapi_audit;

CREATE OR REPLACE
PACKAGE
	tapi_audit IS PROCEDURE tapi_audit_specify_secret_key(i_key varchar2);

PROCEDURE tapi_audit_enable(i_table_name varchar2);

PROCEDURE tapi_audit_disable(i_table_name varchar2);
END tapi_audit;

CREATE OR REPLACE
PACKAGE
	BODY tapi_audit IS
	secret_key VARCHAR2(30);

PROCEDURE tapi_audit_specify_secret_key(i_key varchar2) IS
BEGIN
	secret_key := i_key;

dbms_session.set_context('skey',
	'SECRET_KEY',
	secret_key);
END tapi_audit_specify_secret_key;

PROCEDURE tapi_audit_enable(i_table_name varchar2) IS
BEGIN
IF
		i_table_name = 'ARTICLE' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER ARTICLE_TRG_BIUDR ENABLE';
ELSE
IF
	i_table_name = 'ARTICLE' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER ARTICLE_COMMENT_TRG_BIUDR ENABLE';
ELSE raise_application_error(exceptions.id_table_not_found,
'Table not found');
END
IF;
END
IF;
END tapi_audit_enable;

PROCEDURE tapi_audit_disable(i_table_name varchar2) IS
BEGIN
IF
		i_table_name = 'ARTICLE' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER ARTICLE_TRG_BIUDR DISABLE';
ELSE
IF
	i_table_name = 'ARTICLE' THEN EXECUTE IMMEDIATE 'ALTER TRIGGER ARTICLE_COMMENT_TRG_BIUDR DISABLE';
ELSE raise_application_error(exceptions.id_table_not_found,
'Table not found');
END
IF;
END
IF;
END tapi_audit_disable;

PROCEDURE tapi_audit_activate_trigger(i_table_name varchar2,
i_enable boolean,
i_key varchar2) IS
BEGIN
IF
		i_key <> secret_key THEN raise_application_error(exceptions.id_no_access,
		'No access');
ELSE
IF
			i_enable = TRUE THEN tapi_audit_enable(i_table_name);
ELSE tapi_audit_disable(i_table_name);
END
IF;
END
IF;
END tapi_audit_activate_trigger;
END tapi_audit;

