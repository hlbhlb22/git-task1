--Create or replace type of article row object
CREATE OR REPLACE
TYPE report_articles_type AS OBJECT (week_day int,
num_of_articles int);
--Create or replace type of comment row object
CREATE OR REPLACE
TYPE report_comments_type AS OBJECT (hour_period NUMBER(2),
exact_num_of_comments int,
rolling_num_of_comments float);
--Create or replace type of article table object
CREATE OR REPLACE
TYPE report_articles_table AS TABLE OF report_articles_type;
--Create or replace type of comment table object
CREATE OR REPLACE
TYPE report_comments_table AS TABLE OF report_comments_type;
--Create or replace package declaration for stats
CREATE OR REPLACE
PACKAGE
	stats AS FUNCTION report_articles(i_begin_date IN DATE,
	i_end_date IN DATE) RETURN report_articles_table PIPELINED;

FUNCTION report_comments (i_begin_date IN DATE,
i_end_date IN DATE) RETURN report_comments_table PIPELINED;
END stats;
--Create or replace package body for stats
CREATE OR REPLACE
PACKAGE
	BODY stats AS 
	--Piplined function for report articles
	FUNCTION report_articles(i_begin_date IN DATE,
	i_end_date IN DATE) RETURN report_articles_table PIPELINED IS CURSOR article_c IS
SELECT
	TO_CHAR(dd.D_DATE, 'd') AS week_day,
	count(*) AS num_of_articles
FROM
	DIM_ARTICLE da
LEFT JOIN DIM_DATES dd ON
	TO_CHAR(da.crt_dt, ' dd.MM.yyyy') = TO_CHAR(dd.D_DATE, ' dd.MM.yyyy')
WHERE
	da.IS_ACT_IND = 1
	AND da.crt_dt BETWEEN i_begin_date AND i_end_date
GROUP BY
	TO_CHAR(dd.D_DATE, 'd');

v_week_day int;

v_num_of_articles int;

BEGIN
	OPEN article_c;

LOOP
	FETCH article_c
INTO
	v_week_day,
	v_num_of_articles;

EXIT
WHEN article_c%notfound;

pipe ROW(report_articles_type(v_week_day,
v_num_of_articles));
END
LOOP;

CLOSE article_c;

RETURN;
END report_articles;

--Piplined function for comments
FUNCTION report_comments (i_begin_date IN DATE,
i_end_date IN DATE) RETURN report_comments_table PIPELINED AS CURSOR comments_c IS
--Get data for report
SELECT
	tt.hour_period AS hour_period,
	tt.exact_num_of_comments AS exact_num_of_comments,
	(tt.exact_num_of_comments + tt.lg + tt.ld) / 3 AS rolling_num_of_comments
FROM
	(
	--converting nulls in lead and lag
	SELECT
		t.hour_period AS hour_period,
		t.exact_num_of_comments AS exact_num_of_comments,
		CASE
			WHEN lag(t.exact_num_of_comments) OVER(ORDER BY t.exact_num_of_comments) IS NULL THEN 0
			ELSE CASE
				WHEN hour_period - 1 = lag(t.hour_period) OVER(ORDER BY t.hour_period) THEN lag(t.exact_num_of_comments) OVER(ORDER BY t.exact_num_of_comments)
				ELSE 0
			END
		END AS lg,
		CASE
			WHEN lead(t.exact_num_of_comments) OVER(ORDER BY t.exact_num_of_comments) IS NULL THEN 0
			ELSE CASE
				WHEN hour_period + 1 = lead(t.hour_period) OVER(ORDER BY t.hour_period) THEN lead(t.exact_num_of_comments) OVER(ORDER BY t.exact_num_of_comments)
				ELSE 0
			END
		END AS ld
	FROM
		(
		--Get hour "23" for rolling number of comments
		SELECT
			-1 AS hour_period,
			count(*) AS exact_num_of_comments
		FROM
			F_ARTICLE_COMMENT fac
		INNER JOIN DIM_DATES dd ON
			dd.ID = fac.DATE_ID
		WHERE
			EXTRACT(HOUR FROM fac.TIME_IVAL) = 23
			-- TODO: use trunc(<date>) to remove a time fraction:
			AND to_date(to_char(dd.D_DATE, 'dd.MM.yyyy'), 'dd.MM.yyyy') >= to_date(to_char(i_begin_date, 'dd.MM.yyyy'), 'dd.MM.yyyy')
				AND to_date(to_char(dd.D_DATE, 'dd.MM.yyyy'), 'dd.MM.yyyy') <= to_date(to_char(i_end_date, 'dd.MM.yyyy'), 'dd.MM.yyyy')
			GROUP BY
				EXTRACT(HOUR FROM fac.TIME_IVAL)
		UNION ALL
		--Get all data
			SELECT
				EXTRACT(HOUR FROM fac.TIME_IVAL) AS hour_period,
				count(*) AS exact_num_of_comments
			FROM
				F_ARTICLE_COMMENT fac
			INNER JOIN DIM_DATES dd ON
				dd.ID = fac.DATE_ID
			WHERE
				to_date(to_char(dd.D_DATE, 'dd.MM.yyyy'), 'dd.MM.yyyy') >= to_date(to_char(i_begin_date, 'dd.MM.yyyy'), 'dd.MM.yyyy')
					AND to_date(to_char(dd.D_DATE, 'dd.MM.yyyy'), 'dd.MM.yyyy') <= to_date(to_char(i_end_date, 'dd.MM.yyyy'), 'dd.MM.yyyy')
				GROUP BY
					EXTRACT(HOUR FROM fac.TIME_IVAL)
			UNION ALL
			--Get "0" hour for rolling time of comments
				SELECT
					24 AS hour_period,
					count(*) AS exact_num_of_comments
				FROM
					F_ARTICLE_COMMENT fac
				INNER JOIN DIM_DATES dd ON
					dd.ID = fac.DATE_ID
				WHERE
					EXTRACT(HOUR FROM fac.TIME_IVAL) = 0
					AND to_date(to_char(dd.D_DATE, 'dd.MM.yyyy'), 'dd.MM.yyyy') >= to_date(to_char(i_begin_date, 'dd.MM.yyyy'), 'dd.MM.yyyy')
						AND to_date(to_char(dd.D_DATE, 'dd.MM.yyyy'), 'dd.MM.yyyy') <= to_date(to_char(i_end_date, 'dd.MM.yyyy'), 'dd.MM.yyyy')
					GROUP BY
						EXTRACT(HOUR FROM fac.TIME_IVAL)) t) tt;

BEGIN 

FOR rec IN comments_c LOOP

pipe ROW (rec);
END
LOOP;

RETURN;
END report_comments;
END stats;

--Create or replace view for article report
CREATE OR REPLACE
VIEW DIM_ARTICLE_V AS

SELECT
	rep1.week_day,
	rep1.num_of_articles
FROM
	STATS.REPORT_ARTICLES(current_date,
	current_date) rep1;
	
	
--Create or replace view for comment report
CREATE OR REPLACE
VIEW F_ARTICLE_COMMENT_V AS
SELECT
	rep2.hour_period,
	rep2.exact_num_of_comments,
	rep2.rolling_num_of_comments
FROM
	STATS.REPORT_COMMENTS(current_date,
	current_date) rep2; 