CREATE OR REPLACE TRIGGER DELL.article_audit_trg_biudr
BEFORE INSERT OR UPDATE OR DELETE ON article
FOR EACH ROW 
DECLARE 
v_action char;
v_user_name varchar2(128);
v_row_id int;
BEGIN 

   IF inserting THEN 
        v_action := 'I'; v_row_id:= :NEW.id;
    ELSIF updating THEN 
        v_action := 'U'; v_row_id:= :NEW.id;
    ELSIF deleting THEN 
       v_action := 'D';
END IF;
	SELECT sys_context('userenv', 'CURRENT_USER') INTO v_user_name FROM dual;
	DELL.audit_action_p(current_timestamp, 'ARTICLE',v_row_id, v_user_name, v_action,'итог');
END;



