END tapi_comment;
--Create or replace package body of tapi_comment
CREATE OR REPLACE
PACKAGE
	BODY tapi_comment IS
--Procedure for update or insert data by SQL MERGE 
PROCEDURE tapi_comment_save (i_id NUMBER,
	i_article_id NUMBER,
	i_reply_to_id NUMBER,
	i_commenter varchar2,
	i_content clob)
IS
BEGIN
		MERGE
INTO
	ARTICLE_COMMENT ac
		USING DUAL
ON
	(ac.id = i_id)
	WHEN MATCHED THEN
UPDATE
SET
	ac.ARTICLE_ID = i_article_id,
	ac.REPLY_TO_ID = i_reply_to_id,
	ac.COMMENTER = i_commenter,
	ac.CONTENT = i_content
WHERE
	ac.ID = i_id
	WHEN NOT MATCHED THEN
INSERT
	(ARTICLE_ID,
	REPLY_TO_ID,
	COMMENTER,
	CONTENT)
VALUES (i_article_id,
i_reply_to_id,
i_commenter,
i_content)
WHERE
i_id = 0;
END tapi_comment_save;
--Procedure for creating comment by tapi_comment_save
PROCEDURE tapi_comment_create(i_article_id NUMBER,
i_reply_to_id NUMBER,
i_commenter varchar2,
i_content clob)
    IS
BEGIN
	tapi_comment_save(0,
	i_article_id,
	i_reply_to_id,
	i_commenter,
	i_content);
END tapi_comment_create;
--Procedure for changing comment by tapi_comment_save
PROCEDURE tapi_comment_change(i_id NUMBER,
i_article_id NUMBER,
i_reply_to_id NUMBER,
i_commenter varchar2,
i_content clob)
    IS
BEGIN
	tapi_comment_save(i_id,
	i_article_id,
	i_reply_to_id,
	i_commenter,
	i_content);
END tapi_comment_change;
--Procedure for incrementing number of votes after like or dislike
PROCEDURE tapi_change_votes (i_id NUMBER,
i_votes NUMBER) IS
BEGIN
	UPDATE
	ARTICLE_COMMENT
SET
	VOTES =
CASE
		WHEN VOTES IS NULL THEN i_votes
		ELSE votes + i_votes
	END
WHERE
	ID = i_id;
END tapi_change_votes;
--Procedure for incrementing or decrementing rating
PROCEDURE tapi_change_rating (i_id NUMBER,
i_rating NUMBER) IS
BEGIN
	UPDATE
	ARTICLE_COMMENT
SET
	RATING =
CASE
		WHEN RATING IS NULL THEN i_rating
		ELSE RATING + i_rating
	END
WHERE
	ID = i_id;
END tapi_change_rating;
--Procedure for dislike: increments votes, decrements rating 
PROCEDURE tapi_comment_add_dislike (i_id NUMBER) IS
BEGIN
	tapi_change_votes(i_id,
	1);

tapi_change_rating (i_id,
-1);
END tapi_comment_add_dislike;
--Procedure for like: increments votes, increments rating 
PROCEDURE tapi_comment_add_like (i_id NUMBER) IS
BEGIN
	tapi_change_votes(i_id,
	1);

tapi_change_rating (i_id,
1);
END tapi_comment_add_like;
END tapi_comment;
--Create or replace view for article_comment from SELECT 
CREATE OR REPLACE
VIEW article_comment_v AS
SELECT
	ac.ID AS id,
	ac.ARTICLE_ID AS article_id,
	a.AUTHOR AS article_author,
	a.TITLE AS article_title,
	ac.TS AS ts,
	ac.RATING AS rating,
	ac.COMMENTER AS commenter,
	ac.CONTENT AS content,
	substr(a.CONTENT, 1, 50) AS in_reply_to
FROM
	ARTICLE a
INNER JOIN ARTICLE_COMMENT ac ON
	a.ID = ac.ARTICLE_ID;

