CREATE TABLE article(id int GENERATED BY DEFAULT ON
NULL AS IDENTITY,
crt_dt DATE DEFAULT current_date NOT NULL,
mod_dt DATE DEFAULT current_date NOT NULL,
author varchar2(128) NOT NULL,
title varchar2(50) NOT NULL,
content clob NOT NULL,
CONSTRAINT article_pk PRIMARY KEY (id));

CREATE TABLE article_comment(id int GENERATED BY DEFAULT ON
NULL AS IDENTITY,
article_id int NOT NULL,
ts timestamp(0) DEFAULT CURRENT_TIMESTAMP NOT NULL,
reply_to_id int,
rating int,
votes int,
commenter varchar2(128) NOT NULL,
content clob NOT NULL,
CONSTRAINT article_comment_pk PRIMARY KEY (id),
CONSTRAINT acticle_comment_fk_article FOREIGN KEY (reply_to_id) REFERENCES article(id) ON
DELETE
	CASCADE) 
PARTITION BY RANGE (ts) INTERVAL (NUMTOYMINTERVAL(1, 'YEAR'))(PARTITION article_comment_p
VALUES less than (TO_DATE('3-8-2023', 'DD-MM-YYYY')));

CREATE TABLE audit_action(id NUMBER(38,
0) GENERATED BY DEFAULT ON
NULL AS IDENTITY,
ts timestamp(0) NOT NULL,
table_name varchar2(128) NOT NULL,
user_name varchar2(128) NOT NULL,
action_type char(1) NOT NULL,
action_summary varchar2(250),
CONSTRAINT audit_action_pk PRIMARY KEY (id)
);

CREATE OR REPLACE
TRIGGER article_trg_biur
BEFORE
INSERT
	OR 
UPDATE
	ON
	article FOR EACH ROW
BEGIN
	IF
			(:NEW.author IS NULL) THEN raise_application_error(-20101,
			'Person is not specified');
END
IF;
IF
			(:NEW.content IS NULL) THEN raise_application_error(-20102,
			'Content can’t be empty');
END
IF;
IF
			(:NEW.title IS NULL) THEN raise_application_error(-20104,
			'Title must be specified');
END
IF;
IF
			(lower(:NEW.title) <> :NEW.title) THEN raise_application_error(-20103,
			'Title can’t be in UPPER CASE');
END
IF;
END;

