--Create table for articles with autoincrement primary key
CREATE TABLE article(id int GENERATED BY DEFAULT ON
NULL AS IDENTITY,
crt_dt DATE DEFAULT current_date NOT NULL,
mod_dt DATE DEFAULT current_date NOT NULL,
author varchar2(128) NOT NULL,
title varchar2(50) NOT NULL,
content clob NOT NULL,
CONSTRAINT article_pk PRIMARY KEY (id)) TABLESPACE tablesp;

-Create table for comments with autoincrement primary key foreign keys and partition 
CREATE TABLE article_comment(id int GENERATED BY DEFAULT ON
NULL AS IDENTITY,
article_id int NOT NULL,
ts timestamp(0) DEFAULT CURRENT_TIMESTAMP NOT NULL,
reply_to_id int,
rating int,
votes int,
commenter varchar2(128) NOT NULL,
content clob NOT NULL,
CONSTRAINT article_comment_pk PRIMARY KEY (id),
CONSTRAINT article_comment_fk_article FOREIGN KEY (article_id) REFERENCES article(id) ON
DELETE
	CASCADE,
	CONSTRAINT article_comment_fk_article_comment FOREIGN KEY (reply_to_id) REFERENCES article_comment(id)) PARTITION BY RANGE (ts)
INTERVAL (INTERVAL '1' YEAR)
   (PARTITION PARTMM_01
VALUES LESS THAN
   (TO_DATE('01.01.2023', 'DD.MM.YYYY')) )
ENABLE ROW MOVEMENT;

