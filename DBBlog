--Create or replace trigger for raise exceptions of article table
CREATE OR REPLACE
TRIGGER article_trg_biur
BEFORE
INSERT
	OR 
UPDATE
	ON
	article FOR EACH ROW
BEGIN
	IF
			(:NEW.author IS NULL) THEN raise_application_error(exceptions.id_person_empty,
			'Person is not specified');
END
IF;
IF
			(:NEW.content IS NULL) THEN raise_application_error(exceptions.id_content_empty,
	'Content can’t be empty');
END
IF;
IF
			(:NEW.title IS NULL) THEN raise_application_error(exceptions.id_title_empty,
	'Title must be specified');
END
IF;
IF
			(lower(:NEW.title) <> :NEW.title) THEN raise_application_error(exceptions.id_title_case,
	'Title can’t be in UPPER CASE');
END
IF;
END article_trg_biur;
